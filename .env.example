# Base URL of the Ghostmap backend. Users can override this at runtime on /settings
# (stored in localStorage under "ghostmap.apiBase"); this value is the default.
VITE_API_BASE=https://ghostmap-backend.vercel.app

# Google Identity Services web client id (Google Cloud console -> Credentials ->
# OAuth 2.0 Client ID of type "Web application"). The same id must be listed in the
# backend's GOOGLE_CLIENT_IDS. Leave empty to hide the Google button and use the admin key only.
VITE_GOOGLE_CLIENT_ID=

# --- Playwright E2E only (never used by the browser bundle, never commit real values) ---
# E2E_BASE_URL=http://localhost:5173
# E2E_ADMIN_API_KEY=
# E2E_CLIENT_ACCESS_KEY=
